# ---------------------------------------------------------------
# As planilhas NAO sao enviadas para o GitHub.
#
# Motivo: sao arquivos grandes que mudam por inteiro a cada
# exportacao (o repositorio cresceria rapido) e contem saldos e
# custos da empresa.
#
# Se voce quiser guardar as planilhas tambem, apague as duas
# linhas abaixo. So faca isso se o repositorio for privado.
# ---------------------------------------------------------------
dados/*.xlsx
dados/*.xls

# gerado a cada build, so serve para o servidor local
versao.txt
docs/versao.txt

# coisas desta maquina, nao do projeto
config.txt
vigia.log

__pycache__/
*.pyc
~$*.xlsx
.DS_Store
Thumbs.db
